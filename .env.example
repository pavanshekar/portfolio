# EmailJS credentials for the contact form (https://www.emailjs.com)
# These are exposed in the client bundle by design; restrict usage via the
# EmailJS dashboard (domain allowlist for pavanshekar.github.io).
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
